{
  "name": "invitaciones-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo del frontend nuevo del módulo de plantillas e invitaciones (fase 3: apps/web + packages/schema).",
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "schema:emit": "pnpm --filter @invitaciones/schema run schema:emit",
    "e2e": "pnpm --filter web exec playwright test",
    "budget": "pnpm --filter web run budget"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "eslint": "10.9.1",
    "@eslint/js": "10.0.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.69.0",
    "@types/node": "26.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
