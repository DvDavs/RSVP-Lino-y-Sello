{
  "name": "@invitaciones/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Componentes, formas, ilustraciones y fuentes del sistema de diseño del PRODUCTO (fase 3-C). Radix como base accesible, aspecto propio, color solo desde @invitaciones/tokens. Nunca --inv-*.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./shapes": "./src/shapes/index.ts",
    "./estilos.css": "./src/estilos.css",
    "./fonts/fonts.css": "./src/fonts/fonts.css"
  },
  "scripts": {
    "build": "node scripts/copiar-fuentes-publicas.ts && tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "@invitaciones/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
