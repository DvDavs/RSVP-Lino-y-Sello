{
  "name": "@invitaciones/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Componentes, formas, ilustraciones y fuentes del sistema de diseño del PRODUCTO (fase 3-C). Radix como base accesible, aspecto propio, color solo desde @invitaciones/tokens. Nunca --inv-*.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./shapes": "./src/shapes/index.ts",
    "./componentes": "./src/componentes/index.ts",
    "./componentes/*": "./src/componentes/*",
    "./fonts/preload.ts": "./src/fonts/preload.ts",
    "./ilustraciones/*": "./src/ilustraciones/*",
    "./historias": "./src/historias/index.ts",
    "./estilos.css": "./src/estilos.css",
    "./shapes/shapes.css": "./src/shapes/shapes.css",
    "./componentes/componentes.css": "./src/componentes/componentes.css",
    "./fonts/fonts.css": "./src/fonts/fonts.css",
    "./historias": "./src/historias/index.ts"
  },
  "scripts": {
    "build": "node scripts/copiar-fuentes-publicas.ts && node scripts/metric-override.ts && tsc --noEmit",
    "metric-override": "node scripts/metric-override.ts",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "@invitaciones/icons": "workspace:*",
    "@invitaciones/tokens": "workspace:*",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "class-variance-authority": "0.7.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capsizecss/metrics": "4.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
