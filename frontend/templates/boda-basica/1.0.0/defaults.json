    "couple.bride": {
      "kind": "person",
      "name": "Rebeca Santana"
    },
    "couple.brideText": {
      "kind": "richText",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Mi amor, no encuentro las palabras adecuadas para expresar el gran amor que siento por ti... ¡Te Amo!"
              }
            ]
          }
        ]
      }
    },
    "couple.groom": {
      "kind": "person",
      "name": "Santiago Hernández"
    },
    "couple.groomText": {
      "kind": "richText",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Ante Dios y ante todos nuestros amigos y familiares, deseo que el mundo se entere que te tomo como esposa, para amarte, cuidarte y respetarte por siempre, jurarte fidelidad y compromiso; además de un amor puro y eterno. ¡Juntos por siempre, vida mía!"
              }
            ]
          }
        ]
      }
    },
    "couple.heading": {
      "kind": "text",
      "value": "Save the date!"
    },
    "couple.message": {
      "kind": "richText",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Confirmaremos nuestro amor ante los cielos y las personas que tanto apreciamos; será un momento maravilloso en nuestras vidas en el que diremos el “sí, acepto” ante Dios. Y seremos felices para siempre."
              }
            ]
          }
        ]
      }
    },
