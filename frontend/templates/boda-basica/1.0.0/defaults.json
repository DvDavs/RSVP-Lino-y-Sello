    "story.milestones": {
      "kind": "group",
      "items": [
        {
          "itemId": "TASSEHSM986ZABXPBRDZ1QPYRW",
          "values": {
            "title": {
              "kind": "text",
              "value": "Inicio de nuestro noviazgo"
            },
            "date": {
              "kind": "date",
              "value": "2012-06-07"
            },
            "body": {
              "kind": "richText",
              "doc": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Ese día me encontraba muy nervioso, pues ya llevábamos de amigos casi un año y era momento de que diéramos el primer paso en nuestra relación, así que me decidí a preguntarle si quería ser mi novia, gracias a dios ella aceptó e iniciamos esta hermosa aventura."
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "itemId": "TB80570K6Z2RZAQJGEGTVCMC7F",
          "values": {
            "title": {
              "kind": "text",
              "value": "Propuesta de matrimonio"
            },
            "date": {
              "kind": "date",
              "value": "2019-12-14"
            },
            "body": {
              "kind": "richText",
              "doc": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Fue un dia maravilloso para los dos, no me lo esperaba, después de 8 años de novios, por fin Santiago decidió proponerme matrimonio y formalizar esta relación tan hermosa, él se lució y me sorprendió con la entrega del anillo de compromiso."
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "itemId": "DHDDJGNVC9MX3GA193V949PEPF",
          "values": {
            "title": {
              "kind": "text",
              "value": "Pedida de mano"
            },
            "date": {
              "kind": "date",
              "value": "2019-12-21"
            },
            "body": {
              "kind": "richText",
              "doc": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Decidimos continuar con las tradiciones y ese día vino Santiago con toda su familia a mi casa a pedirle mi mano formalmente a mis padres para que ellos otorgaran su consentimiento de nuestro compromiso, una vez aceptado el mismo Santiago me sorprendió con un espectáculo de juegos pirotécnicos para celebrar la unión oficial de nuestra futura boda."
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
